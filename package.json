{
  "name": "ccf-for-zotero",
  "type": "module",
  "version": "0.2.19",
  "packageManager": "pnpm@12.21.0",
  "description": "Offline CCF and CAS ranking badges for Zotero.",
  "config": {
    "addonName": "CCF for Zotero",
    "addonID": "ccf-for-zotero@nyaru177.github.io",
    "addonRef": "ccf-for-zotero",
    "addonInstance": "CCFForZotero",
    "prefsPrefix": "extensions.ccf-for-zotero"
  },
  "author": "oroiteS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oroiteS/ccf-for-zotero.git"
  },
  "homepage": "https://github.com/oroiteS/ccf-for-zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "pnpm exec zotero-plugin build && pnpm exec tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm run test && pnpm run build",
    "build:ccf-catalog": "node tools/build-ccf-catalog.mjs",
    "build:cas-catalog": "node tools/build-cas-catalog-from-official-export.mjs",
    "audit:cas-catalog": "node tools/audit-cas-catalog.mjs",
    "audit:cas-public-release": "node tools/audit-cas-public-release.mjs",
    "start": "zotero-plugin serve"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
